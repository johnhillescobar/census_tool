{
  "include": [
    "src",
    "app_test_scripts",
    "index",
    "*.py"
  ],
  "exclude": [
    "**/__pycache__",
    "**/node_modules",
    "**/.venv",
    "**/venv",
    "chroma",
    "memory",
    "logs"
  ],
  "extraPaths": [
    "."
  ],
  "pythonVersion": "3.12",
  "typeCheckingMode": "basic",
  "reportMissingImports": true,
  "reportMissingTypeStubs": false,
  "useLibraryCodeForTypes": true,
  "executionEnvironments": [
    {
      "root": ".",
      "pythonVersion": "3.12",
      "extraPaths": [
        "."
      ]
    }
  ]
}
