{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Census: CLI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "CENSUS_CHECKPOINT_DB": "${workspaceFolder}/.debug/cli-checkpoints.db",
                "CENSUS_TELEMETRY_STRICT": "1"
            }
        },
        {
            "name": "Census: Streamlit",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/streamlit_app.py",
                "--server.port=8501",
                "--server.headless=true"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "CENSUS_CHECKPOINT_DB": "${workspaceFolder}/.debug/streamlit-checkpoints.db",
                "CENSUS_TELEMETRY_STRICT": "1"
            }
        },
        {
            "name": "Census: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "src.api.fastapi_app:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "CENSUS_CHECKPOINT_DB": "${workspaceFolder}/.debug/api-checkpoints.db",
                "CENSUS_TELEMETRY_STRICT": "1"
            }
        },
        {
            "name": "Geography: Golden row 3",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/debug_geography_query.py",
            "args": [
                "--golden-row",
                "3",
                "--show-candidates"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "CENSUS_TELEMETRY_STRICT": "1"
            }
        },
        {
            "name": "Geography: Choose golden row",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/debug_geography_query.py",
            "args": [
                "--golden-row",
                "${input:goldenRow}",
                "--show-candidates"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "CENSUS_TELEMETRY_STRICT": "1"
            }
        },
        {
            "name": "Pytest: Current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-v",
                "-s",
                "--tb=short"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "CENSUS_TELEMETRY_STRICT": "1"
            }
        },
        {
            "name": "Pytest: Geography unit suite",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "app_test_scripts/test_census_url_fixtures.py",
                "app_test_scripts/test_retrieval_trace.py",
                "app_test_scripts/test_geography_workflow_planning.py",
                "-v",
                "-s",
                "--tb=short"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "CENSUS_TELEMETRY_STRICT": "1"
            }
        },
        {
            "name": "Pytest: Geography integration",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "app_test_scripts/test_nl_questions_with_urls.py",
                "-m",
                "integration and slow",
                "-v",
                "-s",
                "--tb=short"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "CENSUS_TELEMETRY_STRICT": "1"
            }
        }
    ],
    "inputs": [
        {
            "id": "goldenRow",
            "type": "promptString",
            "description": "Golden question row number",
            "default": "3"
        }
    ]
}